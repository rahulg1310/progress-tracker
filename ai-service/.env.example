# Copy this file to .env and fill in the values marked YOU SUPPLY.
# Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# YOU SUPPLY: the SAME value as SERVICE_AUTH_SECRET in backend/.env (at least 32 characters)
SERVICE_AUTH_SECRET=replace-with-a-long-random-secret

# YOU SUPPLY: the SAME connection string as MONGO_URI in backend/.env
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# YOU SUPPLY: the database that holds your users/games/sessions collections
# (Atlas -> Browse Collections. If MONGO_URI has no database name, Mongoose used "test")
MONGO_DB_NAME=test

# YOU SUPPLY: free-tier key from https://aistudio.google.com/apikey (do NOT enable billing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1024

MAX_HISTORY_MESSAGES=20
CORE_API_URL=http://127.0.0.1:5000

# YOU SUPPLY: the SAME RAWG_API_KEY as in backend/.env (used by Discover)
RAWG_API_KEY=
